set -o vi

# MaKe then Change Directory
function mkcd() {
	mkdir -p "$@" && cd "$@";
}

# After cloning a Git repository, cd into it.
function git() {
	# Identify path to git executable to avoid infinite recursion
	local git="$(type -P git)"
	if [ ! -e "$git" ]; then
		echo Could not locate Git executable
		return 1
	fi

	# Run Git and check exit code
	"$git" "$@"; local git_exit=$?
	[ $git_exit -ne 0 ] && return $git_exit

	if [ "$1" == "clone" ]; then
	cd $(basename "${!#}" .git)
	fi
}

function cdup() {
	[ -z "$1" ] && travel=1 || travel=$1
	for i in $(seq $travel); do
		cd ..
	done
}

# This might actually be a terrible idea anything which is not nix-on-droid
# The SSH keys seem to get stored forever on x86-64 systems? That's not at all what I want!
function ssh-auth() {
	# Use a consistent socket path for the agent
	agent_sock="/tmp/ssh-agent.sock"

	# Check if the socket is still responding, if not, spawn/reset it
	ssh-add -l &>/dev/null
	if [ $? -eq 2 ]; then
		[ -S "$agent_sock" ] && rm -f "$agent_sock"
		eval $(ssh-agent -sa "$agent_sock")
	else
		echo ssh-agent is already running
	fi
	ssh-add ~/.ssh/id*[^.pub]
}
# Stop agent (if any) on nix-on-droid when the session ends
trap '[ $USER == nix-on-droid -a $SHLVL -eq 1 -a ! -z $SSH_AGENT_PID ] && eval $(ssh-agent -k)' EXIT

# PS1 is set here so it overrides config.programs.bash.promptInit
# (which we cannot set from home-manager)
# This prompt produces the following:
# [username@hostname:~/folder]
# $
# And in sub-shells, it shows how many shells deep you are:
# [username@hostname:~/folder] (2)
# $
# Having the directory path *before* the prompt marker always seemed odd to me.
# For long directory paths, the prompt is pushed way over to the right and can wrap onto a new line quickly.
# Why?? Why not dedicate a line to any useful information and allow the prompt to stay left?

function _prompt_command() {
	[ -z $1 ] && lvl=0 || lvl=$1
	lvl=$((lvl+1))
	[ $lvl -gt 1 ] && out=" ($lvl)"
	export PS1_CMD1="$out"
}
export PROMPT_COMMAND='_prompt_command $SHLVL'
export PS1="\n\[\e[32;1m\][\u@\h:\w]${PS1_CMD1}\n\[\e[0m\]\$ "
